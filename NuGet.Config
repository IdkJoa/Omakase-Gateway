<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Increase timeout to 600s for large packages like Aspire SDK -->
    <add key="http_timeout" value="600" />
  </config>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
