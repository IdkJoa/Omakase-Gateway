{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "TrustAll": true,
    "KnownProxies": []
  },
  "RateLimiting": {
    "Limit": 100,
    "WindowSeconds": 60
  },
  "AuditChannel": {
    "Capacity": 10000
  },
  "AuditWorker": {
    "BatchSize": 50,
    "RetryDelaySeconds": 5
  },
  "ProxyReload": {
    "IntervalSeconds": 30
  },
  "GeoLocation": {
    "BaseUrl": "http://ip-api.com/",
    "TimeoutSeconds": 1,
    "CacheTtlHours": 1
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_IN_PRODUCTION_USE_AZURE_KEY_VAULT_MIN_32_BYTES!!",
    "Issuer": "omakase-gateway",
    "Audience": "omakase-services",
    "AccessTokenTtlMinutes": 15,
    "RefreshTokenTtlDays": 7
  },
  "Mfa": {
    "ChallengeTtlSeconds": 180,
    "StepUpTtlMinutes": 10,
    "MaxAttempts": 5,
    "AttemptWindowMinutes": 15,
    "LockoutMinutes": 30,
    "Issuer": "Omakase-Gateway"
  }
}

