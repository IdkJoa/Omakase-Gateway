{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "TrustAll": true,
    "KnownProxies": []
  },
  "RateLimiting": {
    "Limit": 100,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "catch-all": {
        "ClusterId": "upstream-default",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "upstream-default": {
        "Destinations": {
          "primary": {
            "Address": "https://httpbin.org/"
          }
        }
      }
    }
  }
}
