{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "TrustAll": true,
    "KnownProxies": []
  },
  "RateLimiting": {
    "Limit": 100,
    "WindowSeconds": 60
  },
  "AuditChannel": {
    "Capacity": 10000
  },
  "AuditWorker": {
    "BatchSize": 50,
    "RetryDelaySeconds": 5
  },
  "ProxyReload": {
    "IntervalSeconds": 30
  }
}
