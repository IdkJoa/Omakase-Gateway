<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>OmakaseGateway.Api</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
        <ProjectReference Include="..\OG.Gateway\OG.Gateway.csproj" />
        <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"                 Version="10.0.3" />
        <!-- Override de seguridad: AspNetCore.OpenApi arrastra Microsoft.OpenApi 2.0.0,
             afectado por GHSA-v5pm-xwqc-g5wc (parcheado en la linea 2.x desde 2.7.5). -->
        <PackageReference Include="Microsoft.OpenApi"                             Version="2.11.0" />
        <PackageReference Include="Yarp.ReverseProxy"                          Version="2.3.0" />
        <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.3" />
        <PackageReference Include="Aspire.StackExchange.Redis"                   Version="13.4.3" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        
    </ItemGroup>

</Project>
